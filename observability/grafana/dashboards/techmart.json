{
  "uid": "techmart-main",
  "title": "TechMart — Backend",
  "tags": ["techmart"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "type": "timeseries",
      "title": "Throughput (req/s theo endpoint)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (uri) (rate(http_server_requests_seconds_count{application=\"techmart\", uri!~\"/actuator.*\"}[1m]))",
          "legendFormat": "{{uri}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency p95 / p99",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"techmart\", uri!~\"/actuator.*\"}[1m])))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"techmart\", uri!~\"/actuator.*\"}[1m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tỉ lệ lỗi theo mã HTTP",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{application=\"techmart\", status!~\"2..\"}[1m]))",
          "legendFormat": "HTTP {{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Từ chối vì nghiệp vụ (hết hàng / hết suất / rate limit)",
      "description": "Đây là các con số cho thấy hệ thống đang BẢO VỆ tồn kho, không phải đang lỗi.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "rate(techmart_inventory_insufficient_stock_total[1m])",
          "legendFormat": "hết hàng"
        },
        {
          "expr": "rate(techmart_flashsale_sold_out_total[1m])",
          "legendFormat": "hết suất flash sale"
        },
        {
          "expr": "rate(techmart_ratelimit_rejected_total[1m])",
          "legendFormat": "bị rate limit"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Hàng đang được giữ",
      "description": "Số bản ghi reservation ở trạng thái HELD. Tăng liên tục không giảm = job nhả hàng có vấn đề.",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 16 },
      "targets": [{ "expr": "techmart_inventory_reservations_active" }]
    },
    {
      "type": "stat",
      "title": "Outbox chưa xử lý",
      "description": "Ứ lại = worker outbox chết hoặc đang lỗi.",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 16 },
      "targets": [{ "expr": "techmart_outbox_events_pending" }]
    },
    {
      "type": "timeseries",
      "title": "HikariCP — connection đang dùng / đang chờ",
      "description": "Số chờ tăng = transaction đang bị giữ quá lâu. Rút ngắn transaction TRƯỚC khi tăng pool.",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 16 },
      "targets": [
        { "expr": "hikaricp_connections_active{application=\"techmart\"}", "legendFormat": "đang dùng" },
        { "expr": "hikaricp_connections_pending{application=\"techmart\"}", "legendFormat": "đang chờ" },
        { "expr": "hikaricp_connections_max{application=\"techmart\"}", "legendFormat": "tối đa" }
      ]
    },
    {
      "type": "timeseries",
      "title": "JVM heap",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 22 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{application=\"techmart\", area=\"heap\"})",
          "legendFormat": "đã dùng"
        },
        {
          "expr": "sum(jvm_memory_max_bytes{application=\"techmart\", area=\"heap\"})",
          "legendFormat": "tối đa"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "GC pause",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 22 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "rate(jvm_gc_pause_seconds_sum{application=\"techmart\"}[1m])",
          "legendFormat": "{{action}}"
        }
      ]
    }
  ]
}
