# Sao chep thanh .env truoc khi chay docker compose
POSTGRES_DB=techmart
POSTGRES_USER=techmart
POSTGRES_PASSWORD=techmart

# Toi thieu 256 bit. Sinh moi: openssl rand -base64 48
JWT_SECRET=doi-chuoi-nay-truoc-khi-deploy-toi-thieu-32-ky-tu-that-dai
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# Bat seed du lieu demo (chi dung o dev/demo, khong bat o production)
APP_SEED_ENABLED=true

# Secret ky webhook cua mock payment gateway
PAYMENT_WEBHOOK_SECRET=mock-webhook-secret-doi-truoc-khi-deploy
